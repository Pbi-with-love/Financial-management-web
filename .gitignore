# ── Dependencies ─────────────────────────────
node_modules/

# ── Build output ─────────────────────────────
dist/
build/
*.tsbuildinfo

# ── Environment & secrets ────────────────────
# Real config never goes into git; only .env.example does.
.env
.env.*
!.env.example
*.pem
*.key

# ── Prisma ───────────────────────────────────
# Keep prisma/schema.prisma and prisma/migrations/ committed.
# Only ignore local SQLite files if someone uses them for quick tests.
*.db
*.db-journal

# ── Tests & coverage ─────────────────────────
coverage/
.vitest/
test-results/
playwright-report/

# ── Vite / frontend cache ────────────────────
.vite/
*.local

# ── Logs ─────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Editors & OS ─────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
.DS_Store
Thumbs.db

# ── AI agent / tooling scratch files ─────────
.claude/settings.local.json
.playwright-mcp/